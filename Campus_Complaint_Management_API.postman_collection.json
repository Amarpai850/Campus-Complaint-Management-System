			"name": "Authentication",
			"item": [
				{
					"name": "Register Student",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"student1\",\n    \"password\": \"student123\",\n    \"email\": \"student1@campus.edu\",\n    \"fullName\": \"Jane Student\",\n    \"phone\": \"9876543210\",\n    \"department\": \"Computer Science\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Register a new student account (public endpoint)"
					}
				}
			]
		},
